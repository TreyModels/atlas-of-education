 "mapping": [
  {
   "output": "ger",
   "definition": "share of households with a child in school (model states 0,1); no age band, no grade, no repetition, one child per household",
   "candidates": "D1 pre_ger (primary GER, 248 codes incl. aggregates, 1970-2022); D1 prm_ner/sec_ner (net enrolment, 236/227 countries, 1970-2019); D1 lsc (lower-secondary completion); D5 mean years of schooling; D6 DHS women's education",
   "age_unit_definition_period": "GENERAL/PARTIAL: gross enrolment ratio (pupils of any age / official-age population, can exceed 100%) vs a household participation share; net enrolment is age-specific (model has no age); completion/attainment is a stock, not participation; calendar vs synthetic time",
   "status": "partial",
   "reason": "no age/grade structure in the model; gross-vs-net and participation-vs-attainment mismatch cannot be removed without an invented mapping"
  },
  {
   "output": "cl",
   "definition": "share of households in observed child employment (states 1+2)",
   "candidates": "D1 child_work (ILO/UCW children 7-14 in employment; 100 countries; 1994-2016; sparse); D2 child_labour (ILO/UNICEF, children 5-17; 21-country cross-section, years differ)",
   "age_unit_definition_period": "PARTIAL: employment definition broadly matches, but the model has no age band while observed series are 7-14 or 5-17; child-weighted vs household-weighted; ILO modelled/administrative estimates; sparse irregular panel",
   "status": "partial",
   "reason": "age band and unit differ; observations are sparse and irregular (not a change panel); no joint panel with the other states"
  },
  {
   "output": "sw",
   "definition": "study-and-work share (state 1)",
   "candidates": "UCW publishes study-and-work shares, but the committed cache (D1 child_work.json) holds only the total employment series; no work-only/study-and-work split is committed",
   "age_unit_definition_period": "NO COMMITTED SERIES",
   "status": "unmatched",
   "reason": "observed decomposition not present in the repo"
  },
  {
   "output": "wo",
   "definition": "visible-work-only share (state 2)",
   "candidates": "same as sw: work-only share is not in the committed cache",
   "age_unit_definition_period": "NO COMMITTED SERIES",
   "status": "unmatched",
   "reason": "observed decomposition not present in the repo"
  },
  {
   "output": "hw",
   "definition": "hidden work (state 3); unobserved by construction",
   "candidates": "none: surveys do not observe hidden/unpaid non-employment activity as this model defines it",
   "age_unit_definition_period": "NO OBSERVED COUNTERPART",
   "status": "unmatched",
   "reason": "not measurable with the repo's observed data"
  },
  {
   "output": "tut",
   "definition": "share of households using tutoring",
   "candidates": "D3 shadow-education incidence/fees (hand-collected; 38+20 rows; several case studies, not national; definitions and years differ)",
   "age_unit_definition_period": "PARTIAL/UNMATCHED: no harmonised country-year panel; case-study definitions; tutoring 'participation' differs across sources",
   "status": "unmatched",
   "reason": "no comparable panel; using it would invent a national tutoring target"
  },
  {
   "output": "learn",
   "definition": "mean learning in model grade-equivalents (model-internal scale)",
   "candidates": "D1 test_scores (WDI harmonized test scores 0-625, 172 countries, 2010-2020); D1 hci (learning index 0-1); D5 schooling attainment",
   "age_unit_definition_period": "UNIT MISMATCH: model grade-equivalents have no empirical scale mapping to test-score points or HCI units; observed period only 2010-2020",
   "status": "partial",
   "reason": "unit/scale cannot be mapped without an invented calibration; no period overlap with a documented model episode"
  },
  {
   "output": "inc",
   "definition": "mean household income in model units (arbitrary logarithmic scale)",
   "candidates": "D1 gdppc_log (257 countries, 1960-2024); D5 Maddison GDP pc",
   "age_unit_definition_period": "UNIT MISMATCH: country GDP per capita in dollars vs household mean in arbitrary model units; household vs country; only scale-free shapes could be compared by inventing a normalisation",
   "status": "unmatched",
   "reason": "no level/unit link; would require an invented scaling target"
  },
  {
   "output": "B1",
   "definition": "within-mother post-death birth-spacing contrast",
   "candidates": "none: no birth-interval microdata in the repo (DHS API publishes no such cell; microdata acquisition forbidden)",
   "age_unit_definition_period": "NO OBSERVED COUNTERPART",
   "status": "unmatched",
   "reason": "requires microdata that the pilot may not acquire"
  },
  {
