+    # ------------------------------------------------------------------ contest expected probabilities
+    def _contest_boost(self, x_eff, elite9):
+        """Persistent Grade-9 placement advantage in a later contest's effective input (multiplicative, unit-free)."""
+        p = self.p
+        b = p['g9_consequence'] * p['g9_contest_boost']
+        if b <= 0.0:
+            return x_eff
+        return x_eff * (1.0 + b * np.asarray(elite9, float))
+
+    def contest_prob(self, m_, x_eff):
+        """Expected top-K (seats) admission probability under the gate's own Gumbel-max Plackett-Luce mechanism.
+
+        Logistic in log effective contest input: P = sigmoid(beta * (log x_eff - c_K)). beta and c_K are
+        re-estimated every gate year by vectorised Monte Carlo of the *same* ranking the gate uses (see
+        `_fit_contest_prob`), then re-centred so the mean expected probability equals min(seats/applicants, 0.99).
+        The identical function is used by household values (`values`) and effort choice (`TutoringMarket.extras`),
+        so expected and realised probabilities are one mechanism, not two approximations.
+        """
+        b = float(self.contest_beta[m_])
+        c = float(self.contest_cut[m_])
+        z = np.clip(b * (np.log(np.maximum(np.asarray(x_eff, float), 1e-6)) - c), -30.0, 30.0)
+        return 1.0 / (1.0 + np.exp(-z))
+
+    def _fit_contest_prob(self, m_, x_eff, seats, r_c):
+        """Estimate the expected top-K admission curve by Monte Carlo of the gate's Gumbel-max ranking.
+
+        For each candidate i, p_i = share of M independent Gumbel draws in which i ranks in the top `seats`
+        (weights w = x_eff**r). A weighted least-squares logit link in log x_eff gives the slope beta; the
+        intercept is then chosen by bisection so that mean(p) = min(seats/n, 0.99) (market clearing). The fit is
+        deliberately re-estimated every gate year from the current candidate field, so it tracks the realised
+        mechanism rather than a fixed approximation. Degenerate fits fall back to beta = 1 (flagged by leaving
+        beta at the fallback; the runner reports beta_last per gate).
+        """
+        n = int(len(x_eff))
+        if n == 0:
+            return
+        M = max(int(self.p['contest_mc_draws']), 16)
+        x_eff = np.maximum(np.asarray(x_eff, float), 1e-9)
+        w = np.log(x_eff) * float(r_c)
+        u = self.rng_fit.random((M, n))
+        g = -np.log(-np.log(np.clip(u, 1e-12, 1.0 - 1e-12)))
+        score = w[None, :] + g
+        order = np.argsort(-score, axis=1)
+        rank = np.empty((M, n), dtype=np.int32)
+        rank[np.arange(M)[:, None], order] = np.arange(n, dtype=np.int32)
+        p_mc = (rank < int(max(seats, 1))).mean(0)
+        ph = np.clip(p_mc, 0.5 / (M + 2.0), 1.0 - 0.5 / (M + 2.0))
+        yv = np.log(ph / (1.0 - ph))
+        lx = np.log(x_eff)
+        ww = ph * (1.0 - ph)
+        A = np.array([[np.sum(ww), np.sum(ww * lx)], [np.sum(ww * lx), np.sum(ww * lx * lx)]])
+        rhs = np.array([np.sum(ww * yv), np.sum(ww * lx * yv)])
+        try:
+            a, b = np.linalg.solve(A + 1e-9 * np.eye(2), rhs)
+        except np.linalg.LinAlgError:
+            a, b = float(np.mean(yv)), 1.0
+        a, b = float(a), float(b)
+        if not (0.1 <= b <= 5.0):        # degenerate field (near-constant x_eff / all/none admitted): fall back
+            b = 1.0
+            a = float(np.mean(yv - b * lx))
+        target = min(float(seats) / n, 0.99)
+        lo, hi = -60.0, 60.0
+        for _ in range(50):
+            mid = 0.5 * (lo + hi)
+            if float(np.mean(1.0 / (1.0 + np.exp(-np.clip(mid + b * lx, -30.0, 30.0))))) < target:
+                lo = mid
+            else:
+                hi = mid
+        a = 0.5 * (lo + hi)
+        self.contest_beta[m_] = b
+        self.contest_cut[m_] = -a / b
+
+    def _record_contest_calib(self, m_, x_eff, effort, p_exp, ok, seats):
+        """Accumulate expected-vs-realised admission and seat denominators for the runner (§3-§4 of the plan)."""
+        C = self.contest_calib[m_]
+        n = int(len(p_exp))
+        C['n_years'] += 1
+        C['applicants'] += n
+        C['seats'] += int(seats)
+        C['admitted'] += int(np.sum(ok))
+        C['ratio_sum'] += float(n) / max(int(seats), 1)
+        C['beta_last'] = float(self.contest_beta[m_])
+        C['cut_last'] = float(self.contest_cut[m_])
+        if n == 0:
+            return
+        p = np.clip(np.asarray(p_exp, float), 1e-6, 1.0 - 1e-6)
+        ok = np.asarray(ok, bool)
+        C['brier'] += float(np.sum((p - ok) ** 2))
+        C['n_pred'] += n
+        flat = min(float(seats) / n, 0.99)
+        C['brier_flat'] += float(np.sum((flat - ok) ** 2))
+        b = np.clip((p * 10.0).astype(int), 0, 9)
+        for j in range(10):
+            msk = b == j
+            c = int(msk.sum())
+            C['cnt_bin'][j] += c
+            C['exp_bin'][j] += float(np.sum(p[msk]))
+            C['real_bin'][j] += float(np.sum(ok[msk]))
+        e = np.asarray(effort, float)
+        if n >= 5:
+            qs = np.quantile(e, [0.2, 0.4, 0.6, 0.8])
+            eq = np.clip(np.searchsorted(qs, e, side='left'), 0, 4)
+            for j in range(5):
+                msk = eq == j
+                c = int(msk.sum())
+                C['cnt_eff'][j] += c
+                C['exp_eff'][j] += float(np.sum(p[msk]))
+                C['real_eff'][j] += float(np.sum(ok[msk]))
+                C['eff_sum'][j] += float(np.sum(e[msk]))
+
